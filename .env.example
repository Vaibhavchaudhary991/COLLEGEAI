# Django Settings
SECRET_KEY=django-insecure-dev-key-change-this-in-production-abc123xyz456
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# File Upload Settings
MAX_UPLOAD_SIZE_MB=10

# Google OAuth Credentials (optional, from https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ─── RAG & LLM API Keys ───────────────────────────────────────────────────────
# Fast inference via Groq (Free key at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API key (Free key at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
